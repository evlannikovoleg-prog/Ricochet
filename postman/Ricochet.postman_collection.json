          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('ok=true', () => pm.expect(pm.response.json().ok).to.eql(true));"
