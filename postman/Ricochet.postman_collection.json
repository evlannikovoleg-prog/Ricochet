    {
      "name": "04 · Butterfly",
      "item": [
        {
          "name": "GET пары (готовый прогон)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('258 pairs total', () => pm.expect(j.total).to.eql(258));",
                  "pm.test('candidate returned', () => pm.expect(j.pairs[0].class).to.eql('BUTTERFLY_CANDIDATE'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/butterfly/pairs?cls=BUTTERFLY_CANDIDATE&min_score=0.5&limit=3",
            "description": "Читает последний прогон из state/butterfly_last.json. Не запускает пересчёт. Ожидается 258 пар."
          },
          "response": []
        },
        {
          "name": "GET граф",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('50 nodes', () => pm.expect(j.nodes).to.have.length(50));",
                  "pm.test('258 edges', () => pm.expect(j.edges).to.have.length(258));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/butterfly/graph",
            "description": "Граф последнего прогона: 50 узлов, 258 рёбер."
          },
          "response": []
        },
        {
          "name": "POST проверить пару",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('NO_OVERLAP', () => pm.expect(j.overlap.verdict).to.eql('NO_OVERLAP'));",
                  "pm.test('NO_COMMON_DEVICES', () => pm.expect(j.shared_unshared.verdict).to.eql('NO_COMMON_DEVICES'));",
                  "pm.test('common = 0', () => pm.expect(j.overlap.common).to.eql(0));",
                  "pm.test('corr_unshared ~ 0.8393', () => pm.expect(Math.abs(j.shared_unshared.corr_unshared - 0.8393)).to.be.below(0.01));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/butterfly/verify",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"key_a\": {\n    \"integration\": \"platform\",\n    \"system\": \"db_oracle_11g\",\n    \"alert_group\": \"AIOS_high\"\n  },\n  \"key_b\": {\n    \"integration\": \"platform\",\n    \"system\": \"os_linux\",\n    \"alert_group\": \"Sent_packets_high\"\n  },\n  \"lag_bins\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Проверка пары db_oracle_11g/AIOS_high ↔ os_linux/Sent_packets_high при lag_bins=3 (15 мин)."
          },
          "response": []
        },
        {
          "name": "POST запустить анализ (фон, ~2.5 мин)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('job_id returned', () => { pm.expect(j.job_id).to.be.a('string'); pm.collectionVariables.set('jobId', j.job_id); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/butterfly/run",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"min_abs_corr\": 0.35,\n  \"min_devices\": 5,\n  \"lags\": 12,\n  \"holdout_last\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Запускает пересчёт в фоне и сразу возвращает job_id. Сам расчёт на полных данных занимает около 2,5 минут. Опрос — в следующем запросе."
          },
          "response": []
        },
        {
          "name": "GET статус job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
