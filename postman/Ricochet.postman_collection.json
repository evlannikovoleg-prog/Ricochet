                  "pm.test('422', () => pm.response.to.have.status(422));",
                  "const j = pm.response.json();",
                  "pm.test('missing field', () => pm.expect(j.detail[0].type).to.eql('missing'));",
                  "pm.test('ts is required', () => pm.expect(j.detail[0].loc).to.include('ts'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
