              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('window id returned', () => { pm.expect(j.id).to.be.a('string'); pm.collectionVariables.set('windowId', j.id); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/maintenance/windows",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": \"2020-04-24T09:00:00\",\n  \"end\": \"2020-04-24T11:00:00\",\n  \"region\": \"MSK\",\n  \"system\": \"os_linux\",\n  \"node\": \"os_linux_05\",\n  \"note\": \"api test scenario\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
