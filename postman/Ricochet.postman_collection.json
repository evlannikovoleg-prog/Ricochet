{
  "info": {
    "name": "Ricochet API · local",
    "description": "Коллекция для локального API «Рикошета» (FastAPI, http://127.0.0.1:8077).\nЗапуск: .\\run_api.ps1 из корня проекта. Swagger: /docs, OpenAPI: /openapi.json.\nАвторизации нет. Все POST — raw JSON, Content-Type: application/json.\nПапка 01: сценарии precheck S1–S6. Папка 02: окна обслуживания S4. Папка 04: butterfly (готовый прогон и опциональный пересчёт).\nДля S5 сначала выполните S1: тело ответа сохраняется в переменную s1_body. Для S4c — сначала S4a.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 · Подключение",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('status = ok', () => pm.expect(j.status).to.eql('ok'));",
                  "pm.test('alarms loaded', () => pm.expect(j.alarms).to.be.above(0));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health",
            "description": "Проверка, что сервис поднят и данные загружены. Ожидается 4 731 050 аварий."
          },
          "response": []
        }
      ],
      "description": ""
    },
    {
      "name": "01 · Precheck (аварии)",
      "item": [
        {
          "name": "S1 · известная platform-авария",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('risk MEDIUM', () => pm.expect(j.risk.level).to.eql('MEDIUM'));",
                  "pm.test('top candidate = Oracle', () => pm.expect(j.root_cause_candidates[0].system).to.eql('db_oracle_11g'));",
                  "pm.test('no maintenance', () => pm.expect(j.maintenance.hit).to.eql(false));",
                  "pm.test('enrichment >= 0.8', () => pm.expect(j.enrichment.completeness).to.be.at.least(0.8));",
                  "pm.collectionVariables.set('s1_body', pm.response.text());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/precheck/alarm",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ts\": \"2020-04-24T10:15:00\",\n  \"integration\": \"platform\",\n  \"system\": \"os_linux\",\n  \"alert_group\": \"Sent_packets_high\",\n  \"node\": \"os_linux_01\",\n  \"region\": \"MSK\",\n  \"severity\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Авария-ведомый (os_linux / Sent_packets_high). Ожидается кандидат db_oracle_11g / AIOS_high, risk 40/MEDIUM."
          },
          "response": []
        },
        {
          "name": "S2 · инцидент 10 узлов / 3 региона",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('risk HIGH', () => pm.expect(j.risk.level).to.eql('HIGH'));",
                  "pm.test('blast nodes = 10', () => pm.expect(j.blast.nodes).to.eql(10));",
                  "pm.test('blast regions = 3', () => pm.expect(j.blast.regions).to.eql(3));",
                  "pm.test('BLAST_RADIUS flag', () => pm.expect(j.risk.flags.map(f => f.code)).to.include('BLAST_RADIUS'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/precheck/incident",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"incident_id\": \"BLAST-10\",\n  \"region\": \"MSK\",\n  \"alarms\": [\n    {\n      \"ts\": \"2020-04-24T10:00:00\",\n      \"integration\": \"platform\",\n      \"system\": \"os_linux\",\n      \"alert_group\": \"Sent_packets_high\",\n      \"node\": \"os_linux_00\",\n      \"region\": \"MSK\",\n      \"severity\": 4\n    },\n    {\n      \"ts\": \"2020-04-24T10:00:00\",\n      \"integration\": \"platform\",\n      \"system\": \"os_linux\",\n      \"alert_group\": \"Sent_packets_high\",\n      \"node\": \"os_linux_01\",\n      \"region\": \"SPB\",\n      \"severity\": 4\n    },\n    {\n      \"ts\": \"2020-04-24T10:00:00\",\n      \"integration\": \"platform\",\n      \"system\": \"os_linux\",\n      \"alert_group\": \"Sent_packets_high\",\n      \"node\": \"os_linux_02\",\n      \"region\": \"EKB\",\n      \"severity\": 4\n    },\n    {\n      \"ts\": \"2020-04-24T10:00:00\",\n      \"integration\": \"platform\",\n      \"system\": \"os_linux\",\n      \"alert_group\": \"Sent_packets_high\",\n      \"node\": \"os_linux_03\",\n      \"region\": \"MSK\",\n      \"severity\": 4\n    },\n    {\n      \"ts\": \"2020-04-24T10:00:00\",\n      \"integration\": \"platform\",\n      \"system\": \"os_linux\",\n      \"alert_group\": \"Sent_packets_high\",\n      \"node\": \"os_linux_04\",\n      \"region\": \"SPB\",\n      \"severity\": 4\n    },\n    {\n      \"ts\": \"2020-04-24T10:00:00\",\n      \"integration\": \"platform\",\n      \"system\": \"os_linux\",\n      \"alert_group\": \"Sent_packets_high\",\n      \"node\": \"os_linux_05\",\n      \"region\": \"EKB\",\n      \"severity\": 4\n    },\n    {\n      \"ts\": \"2020-04-24T10:00:00\",\n      \"integration\": \"platform\",\n      \"system\": \"os_linux\",\n      \"alert_group\": \"Sent_packets_high\",\n      \"node\": \"os_linux_06\",\n      \"region\": \"MSK\",\n      \"severity\": 4\n    },\n    {\n      \"ts\": \"2020-04-24T10:00:00\",\n      \"integration\": \"platform\",\n      \"system\": \"os_linux\",\n      \"alert_group\": \"Sent_packets_high\",\n      \"node\": \"os_linux_07\",\n      \"region\": \"SPB\",\n      \"severity\": 4\n    },\n    {\n      \"ts\": \"2020-04-24T10:00:00\",\n      \"integration\": \"platform\",\n      \"system\": \"os_linux\",\n      \"alert_group\": \"Sent_packets_high\",\n      \"node\": \"os_linux_08\",\n      \"region\": \"EKB\",\n      \"severity\": 4\n    },\n    {\n      \"ts\": \"2020-04-24T10:00:00\",\n      \"integration\": \"platform\",\n      \"system\": \"os_linux\",\n      \"alert_group\": \"Sent_packets_high\",\n      \"node\": \"os_linux_09\",\n      \"region\": \"MSK\",\n      \"severity\": 4\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "10 алертов, 10 узлов, 3 региона. Ожидается risk 60/HIGH и флаг BLAST_RADIUS."
          },
          "response": []
        },
        {
          "name": "S3 · business-авария без кандидатов",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('no candidates', () => pm.expect(j.root_cause_candidates).to.have.length(0));",
                  "pm.test('full enrichment', () => pm.expect(j.enrichment.completeness).to.eql(1));",
                  "pm.test('risk LOW', () => pm.expect(j.risk.level).to.eql('LOW'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/precheck/alarm",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ts\": \"2020-04-24T10:20:00\",\n  \"integration\": \"business\",\n  \"system\": \"esb\",\n  \"alert_group\": \"CSF_fail\",\n  \"node\": \"esb_01\",\n  \"node_alias\": \"esb-alias\",\n  \"region\": \"SPB\",\n  \"severity\": 3\n}",
              "options": {
