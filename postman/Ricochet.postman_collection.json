          "response": []
        },
        {
          "name": "S5 · повтор S1 (идемпотентность)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const prev = pm.collectionVariables.get('s1_body');",
                  "pm.test('same response as S1', () => { pm.expect(prev).to.be.a('string'); pm.expect(pm.response.text()).to.eql(prev); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/precheck/alarm",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ts\": \"2020-04-24T10:15:00\",\n  \"integration\": \"platform\",\n  \"system\": \"os_linux\",\n  \"alert_group\": \"Sent_packets_high\",\n  \"node\": \"os_linux_01\",\n  \"region\": \"MSK\",\n  \"severity\": 4\n}",
              "options": {
