            "url": "{{baseUrl}}/api/v1/precheck/alarm",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ts\": \"2020-04-24T10:15:00\",\n  \"integration\": \"platform\",\n  \"system\": \"os_linux\",\n  \"alert_group\": \"Sent_packets_high\",\n  \"node\": \"os_linux_05\",\n  \"region\": \"MSK\",\n  \"severity\": 4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
