            "description": "Создаёт окно 09:00–11:00 MSK для os_linux/os_linux_05. id сохраняется в переменную windowId."
          },
          "response": []
        },
        {
          "name": "S4b · авария внутри окна",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('maintenance hit', () => pm.expect(j.maintenance.hit).to.eql(true));",
                  "pm.test('risk 70 / HIGH', () => { pm.expect(j.risk.score).to.eql(70); pm.expect(j.risk.level).to.eql('HIGH'); });",
                  "pm.test('MAINTENANCE_OVERLAP', () => pm.expect(j.risk.flags.map(f => f.code)).to.include('MAINTENANCE_OVERLAP'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
